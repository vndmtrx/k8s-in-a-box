# ansible/cni-cilium/templates/cilium-lb-ipam-pool.yml.j2
---
apiVersion: cilium.io/v2alpha1
kind: CiliumLoadBalancerIPPool
metadata:
  name: lb-pool-fixo
spec:
  blocks:
    - start: "{{ lb_ips_fixos.split('-')[0] }}"
      stop: "{{ lb_ips_fixos.split('-')[1] }}"
---
apiVersion: cilium.io/v2alpha1
kind: CiliumLoadBalancerIPPool
metadata:
  name: lb-pool-dinamico
spec:
  blocks:
    - start: "{{ lb_ips_dinamicos.split('-')[0] }}"
      stop: "{{ lb_ips_dinamicos.split('-')[1] }}"
