# ansible/cni-cilium/templates/cilium-l2-policy.yml.j2
---
# Política L2 necessária para associar os IPs dos pools à interface de management dos nós ({{ interface_rede }})
apiVersion: cilium.io/v2alpha1
kind: CiliumL2AnnouncementPolicy
metadata:
  name: l2-policy-k8sbox
  namespace: kube-system
spec:
  serviceSelector:
    matchLabels: {} # Aplica-se a todos os LoadBalancers criados no cluster
  nodeSelector:
    matchLabels:
      kubernetes.io/os: linux
  interfaces:
    - {{ interface_rede }} # Interface de management da VM (cloud-init: set-name por MAC)
  externalIPs: true
  loadBalancerIPs: true
